#!/bin/sh
# herdrssh — run a remote agent in a herdr pane with state reporting.
#
# Run this INSIDE a herdr pane on the hub. It ssh-es to <host>, forwards this
# pane's herdr control socket to the remote side (unix socket -> unix socket),
# and re-exports the pane identity env there. Any herdr hook/integration on
# the remote box then reports agent identity and state straight back into the
# hub server, so the pane shows up as a real agent instead of "ssh".
#
# usage:
#   herdrssh [-C dir] <host> [command [args...]]
#
#   herdrssh llm claude
#   herdrssh llm opencode
#   herdrssh -C ~/src/myproj jetson claude   # start in a remote directory
#   herdrssh workbox            # login shell; launch agents by hand
#
# Extra ssh options can be passed via HERDR_SSH_OPTS, e.g.:
#   HERDR_SSH_OPTS="-J bastion" herdrssh workbox claude
#
# Requirements:
#   hub:    run from inside a herdr pane (HERDR_PANE_ID / HERDR_SOCKET_PATH set)
#   remote: sshd with AllowStreamLocalForwarding (default: yes)
#   remote: herdr hook assets installed for the agents you use
#           (see contrib/remote-pane/README.md)

set -eu

die() {
    echo "herdrssh: $*" >&2
    exit 1
}

workdir=""
host=""
# Accept -C before or after the host: the first non-option arg is the host,
# everything after the second non-option arg is the remote command verbatim.
while [ "$#" -gt 0 ]; do
    case "$1" in
        -C)
            [ "$#" -ge 2 ] || die "-C requires a directory argument"
            workdir="$2"
            shift 2
            ;;
        -C*)
            workdir="${1#-C}"
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            die "unknown option: $1"
            ;;
        *)
            if [ -z "$host" ]; then
                host="$1"
                shift
            else
                break
            fi
            ;;
    esac
done

[ -n "$host" ] || die "usage: herdrssh [-C dir] <host> [command [args...]]"

[ "${HERDR_ENV:-}" = "1" ] || die "not inside a herdr pane (HERDR_ENV != 1)"
[ -n "${HERDR_PANE_ID:-}" ] || die "HERDR_PANE_ID is not set"
[ -n "${HERDR_SOCKET_PATH:-}" ] || die "HERDR_SOCKET_PATH is not set"
[ -S "$HERDR_SOCKET_PATH" ] || die "herdr socket not found at $HERDR_SOCKET_PATH"

# Unique remote socket path: no clash between panes, no stale-bind failures,
# so no sshd StreamLocalBindUnlink requirement.
pane_tag=$(printf '%s' "$HERDR_PANE_ID" | tr -cs 'A-Za-z0-9' '-')
remote_sock="/tmp/herdr-remote-${pane_tag}-$$-$(date +%s).sock"

# Escape a string for embedding inside single quotes.
sq() {
    printf "%s" "$1" | sed "s/'/'\\\\''/g"
}

# Build the remote command: re-export the pane identity, clean the forwarded
# socket up on exit, then run the requested command (or a login shell).
# Commands run through the user's login shell so PATH additions from the
# remote profile (~/.local/bin, nvm, …) apply — agents are rarely on the
# default non-login PATH.
if [ "$#" -gt 0 ]; then
    quoted=""
    for arg in "$@"; do
        quoted="$quoted '$(sq "$arg")'"
    done
    run=" \"\${SHELL:-/bin/sh}\" -l -c '$(sq "$quoted")'"
else
    run=' "${SHELL:-/bin/sh}" -l'
fi

# Optional starting directory. A leading ~ is expanded remotely via $HOME
# (the path is otherwise single-quoted, which would defeat tilde expansion).
cd_cmd=""
if [ -n "$workdir" ]; then
    case "$workdir" in
        "~")   cd_target='"$HOME"' ;;
        "~/"*) cd_target="\"\$HOME\"/'$(sq "${workdir#??}")'" ;;
        *)     cd_target="'$(sq "$workdir")'" ;;
    esac
    cd_cmd="cd $cd_target || exit 1
"
fi

remote_script="export HERDR_ENV=1
export HERDR_PANE_ID='$(sq "$HERDR_PANE_ID")'
export HERDR_SOCKET_PATH='$(sq "$remote_sock")'
trap 'rm -f \"\$HERDR_SOCKET_PATH\"' EXIT HUP INT TERM
$cd_cmd$run"

# shellcheck disable=SC2086  # HERDR_SSH_OPTS is intentionally word-split
exec ssh -t ${HERDR_SSH_OPTS:-} \
    -R "$remote_sock:$HERDR_SOCKET_PATH" \
    "$host" \
    "sh -c '$(sq "$remote_script")'"
